# Local use only (on Vercel, set these under Project > Settings > Environment Variables). All optional.
# Shared default token, so people don't have to paste one in the app:
AIESEC_TOKEN=
# Hide projects hosted in one MC (country id). 0 = show everything.
EXCLUDE_HOME_MC=0
# PORT=3000
# HOST=127.0.0.1
# PER_PAGE=50
# LIST_CONCURRENCY=4
# CONCURRENCY=6
